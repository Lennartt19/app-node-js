{
  "name": "aplicacion-nodejs",
  "version": "1.0.0",
  "description": "API CRUD de tareas con Express y tests con node:test",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "express",
    "crud",
    "tasks",
    "api"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "supertest": "^7.3.2"
  }
}
